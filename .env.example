APP_NAME="SIMPM Project 2"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ===================================================================
# SUPABASE (PostgreSQL)
# ===================================================================
# Ambil nilai-nilai ini dari Supabase Dashboard:
# Project Settings → Database → Connection string → "Nodejs" atau "URI"
#
# ADA 2 PILIHAN HOST — pakai salah satu:
#
# 1) DIRECT CONNECTION (paling sederhana, cocok untuk skripsi/KP,
#    tapi Supabase gratis kadang membatasi jumlah koneksi langsung):
#    Host: db.<project-ref>.supabase.co
#    Port: 5432
#
# 2) SESSION POOLER (lebih stabil untuk banyak koneksi bersamaan,
#    tetap mendukung prepared statements seperti Eloquent butuhkan):
#    Host: aws-0-<region>.pooler.supabase.com
#    Port: 5432
#    Username: postgres.<project-ref>   (bukan cuma "postgres")
#
# JANGAN pakai Transaction Pooler (port 6543) untuk Laravel — mode itu
# tidak mendukung prepared statement yang dipakai Eloquent/Migration.

DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=isi-password-database-supabase-kamu
DB_SSLMODE=require

SESSION_DRIVER=database
CACHE_STORE=file
QUEUE_CONNECTION=sync
